# Copy to .env (never commit .env). Every variable is optional.
# Provider credentials: only needed for real (non-mock) providers.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage location for runs, cache and baselines (SQLAlchemy URL).
LLMBENCH_DB_URL=sqlite:///.llmbench/llmbench.db

# REST API key (required by `llmbench serve` unless --insecure-no-auth is passed).
LLMBENCH_API_KEY=

# Logging: console | json, and whether to redact rendered prompts/outputs in logs.
LLMBENCH_LOG_FORMAT=console
LLMBENCH_LOG_LEVEL=INFO
LLMBENCH_REDACT_PROMPTS=false

# Optional OpenTelemetry tracing (requires the `otel` extra).
LLMBENCH_OTEL_ENABLED=false

# Comma-separated Python modules to import at startup (custom metrics/providers/tasks).
LLMBENCH_PLUGINS=
